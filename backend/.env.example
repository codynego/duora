# Never commit a real secret. Generate at least 32 random characters for production.
NODE_ENV=development
PORT=4000
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
DUORA_JWT_SECRET=replace-with-a-long-random-secret
DUORA_JWT_ISSUER=duora
DUORA_JWT_AUDIENCE=duora-app
# Set true to require tokens locally as well.
DISABLE_DEV_GUESTS=false
